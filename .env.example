# ==============================================================================
# UtkalSarathi Environment Configuration (.env.example)
# Zero-Secret Architecture: Private keys and tokens MUST NOT be committed to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server-Side Environment Variables (Express / Cloud Functions / Serverless)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# Server-side Gemini API Key for Utkal Mitra live conversational AI & voice generation
# NEVER prefix with VITE_ to prevent bundling into client-side JS bundles.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional administrative token for audio asset batch management
AUDIO_ADMIN_GENERATION_TOKEN=your_32_character_admin_token_here

# ------------------------------------------------------------------------------
# 2. Client-Side & Android Network Configuration
# ------------------------------------------------------------------------------
# Production HTTPS backend URL for Android APK and Vercel web:
VITE_API_BASE_URL=https://utkalsarathi.vercel.app
# For LAN testing on a physical Android phone connected to local Wi-Fi, change to:
# VITE_API_BASE_URL=http://<YOUR_LAPTOP_LAN_IP>:3000

# ------------------------------------------------------------------------------
# 3. Client-Side Firebase Configuration (Public / Safe for Web & Capacitor)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=gen-lang-client-0544007391.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=gen-lang-client-0544007391
VITE_FIREBASE_STORAGE_BUCKET=gen-lang-client-0544007391.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=776144599923
VITE_FIREBASE_APP_ID=1:776144599923:web:your_web_app_id
VITE_FIRESTORE_DATABASE_ID=ai-studio-android-utkalsar-47b70c34-5223-4df1-8532-ae48353675b2

# ------------------------------------------------------------------------------
# 4. Android Keystore Signing Configuration (CI / Release Builds)
# ------------------------------------------------------------------------------
UTKALSARATHI_KS_PASS=utkalsarathi
UTKALSARATHI_KEY_ALIAS=utkalsarathi
UTKALSARATHI_KEY_PASS=utkalsarathi
