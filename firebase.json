{
  "firestore": {
    "database": "ai-studio-android-utkalsar-47b70c34-5223-4df1-8532-ae48353675b2",
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "web/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "singleProjectMode": true
  }
}
