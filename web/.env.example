# Public website canonical URL (used in OpenGraph & WhatsApp share links)
VITE_PUBLIC_SITE_URL=https://utkalsarathi.vercel.app

# Optional: Firebase Web App configuration for live Google Sign-In & Cloud Firestore Sync.
# Register a Web App in Firebase Console (Project: gen-lang-client-0544007391),
# add utkalsarathi.vercel.app under Authentication -> Settings -> Authorized domains,
# and set these variables in Vercel Project Settings -> Environment Variables.
# When omitted, UtkalSarathi Web runs cleanly in Local Browser Storage Mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=gen-lang-client-0544007391.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=gen-lang-client-0544007391
VITE_FIREBASE_STORAGE_BUCKET=gen-lang-client-0544007391.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=776144599923
VITE_FIREBASE_APP_ID=
